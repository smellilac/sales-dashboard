root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_size = 4

[*.{csproj,props,targets,slnx,json,yml,yaml}]
indent_size = 2

# Generated EF Core migrations: excluded from analyzers/style enforcement (PKG).
[**/Migrations/**]
generated_code = true
